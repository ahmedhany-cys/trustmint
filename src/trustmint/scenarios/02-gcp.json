  "starts-with@p.iam.gserviceaccount.com": "PUBLIC",
  "owner-id-main@p.iam.gserviceaccount.com": "TENANT",
  "unsupported@p.iam.gserviceaccount.com": "UNDECIDED",
  "in-list@p.iam.gserviceaccount.com": "PROJECT",
  "no-condition@p.iam.gserviceaccount.com": "PUBLIC",
  "protected-branch-or@p.iam.gserviceaccount.com": "PROTECTED",
