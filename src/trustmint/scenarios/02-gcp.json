      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/starts-with/*"
        ]
       }
      ]
     }
    },
    {
     "email": "owner-id-main@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/owner-id-main/*"
        ]
       }
      ]
     }
    },
    {
     "email": "unsupported@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/unsupported/*"
        ]
       }
      ]
     }
    },
    {
     "email": "in-list@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/in-list/*"
        ]
       }
      ]
     }
    },
    {
     "email": "no-condition@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/no-condition/*"
        ]
       }
      ]
     }
    },
    {
     "email": "protected-branch-or@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/protected-branch-or/*"
        ]
       }
      ]
     }
    },
    {
     "email": "no-condition-repo-bound@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principalSet://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/no-condition/attribute.repository/acme/app"
        ]
       }
      ]
     }
    },
    {
     "email": "subject-bound@p.iam.gserviceaccount.com",
     "iam_policy": {
      "bindings": [
       {
        "role": "roles/iam.workloadIdentityUser",
        "members": [
         "principal://iam.googleapis.com/projects/42/locations/global/workloadIdentityPools/owner-eq/subject/repo:acme/app:environment:prod"
        ]
       }
      ]
     }
    }
   ]
  }
 },
