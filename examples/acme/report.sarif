          "informationUri": "https://github.com/ahmedhany-cys/trustmint",
          "rules": [
            {
              "id": "TM001",
              "name": "TM001",
              "shortDescription": {
                "text": "Anyone on the CI platform can assume this identity"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm001",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM002",
              "name": "TM002",
              "shortDescription": {
                "text": "Any repository or project in the organization can assume this identity"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm002",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM003",
              "name": "TM003",
              "shortDescription": {
                "text": "Unprotected branches, pull requests or plans can assume this identity"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm003",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM004",
              "name": "TM004",
              "shortDescription": {
                "text": "A workflow with an untrusted trigger can mint a token this identity accepts"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm004",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM005",
              "name": "TM005",
              "shortDescription": {
                "text": "The trust is bound to names that someone else could take over"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm005",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM006",
              "name": "TM006",
              "shortDescription": {
                "text": "No token satisfies this trust (dead or broken trust)"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm006",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM007",
              "name": "TM007",
              "shortDescription": {
                "text": "The issuer is not a CI platform TrustMint models"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm007",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM008",
              "name": "TM008",
              "shortDescription": {
                "text": "The trust could not be fully evaluated"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm008",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM009",
              "name": "TM009",
              "shortDescription": {
                "text": "A workflow runs untrusted code with id-token: write"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm009",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            },
            {
              "id": "TM010",
              "name": "TM010",
              "shortDescription": {
                "text": "The trust only accepts name-based GitHub subjects"
              },
              "helpUri": "https://github.com/ahmedhany-cys/trustmint/blob/main/docs/rules.md#tm010",
              "properties": {
                "tags": [
                  "security",
                  "oidc",
                  "workload-identity"
                ]
              }
            }
          ]
        }
