      "results": [
        {
          "ruleId": "TM001",
          "level": "error",
          "message": {
            "text": "analytics-reader@acme-prod.iam.gserviceaccount.com: Reachable by any GitHub user, from a repository in an account they create. The witness token below satisfies the trust and its audience check. Fix: Use an attribute condition on `assertion.repository_id` and `assertion.repository_owner_id`, and bind the service account to a single `attribute.repository_id/...` principalSet. Pin it to the immutable subject of the one workflow context that needs it, e.g. `repo:OWNER@OWNER_ID/REPO@REPO_ID:environment:production` with deployment protection rules on that environment, or `...:ref:refs/heads/main` with branch protection. Remove wildcards in the owner and repository parts."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/acme/snapshot.json"
                }
              },
              "logicalLocations": [
                {
                  "name": "analytics-reader@acme-prod.iam.gserviceaccount.com",
                  "kind": "resource"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "trustmint/v1": "TM001:gcp:analytics-reader@acme-prod.iam.gserviceaccount.com#0:github-legacy:github-pool/*"
          },
          "properties": {
            "security-severity": "9.5",
            "reach": "PUBLIC",
            "witness": {
